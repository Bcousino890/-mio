NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública del portal donde se sirven los SmartLinks (/compartir, /c) y
# los assets generados (/og, /p). Se usa para construir URLs absolutas en
# metadatos Open Graph para WhatsApp/Twitter — debe ser el dominio público
# REAL, sin auth básica. En producción: https://portal.bcousinoprop.com.
NEXT_PUBLIC_PORTAL_URL=https://portal.bcousinoprop.com

# Token requerido por el endpoint /api/cron/sync (Fase 4 sindicación).
# Vercel Cron envía la cabecera x-vercel-cron automáticamente, pero para
# disparos manuales o externos usar `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=change-me-to-a-long-random-string

# Fase 5 · scraper de Level Real Estate.
# Cuántas propiedades procesar como máximo por sync. Por defecto 25 (cubre
# 5-10 min con rate limit 2.5s/req). Para el primer sync completo de las
# ~319 propiedades, ejecutar el scraper localmente con LEVEL_SYNC_LIMIT=999.
LEVEL_SYNC_LIMIT=25

# Filtro de zonas (opcional). CSV de palabras clave (sin acentos, lowercase).
# Si está activo, el scraper solo importa propiedades cuya ubicación contenga
# alguna keyword. Match parcial: "salamanca" caza "Barrio de Salamanca".
# Dejar vacío para no filtrar y traer todo el catálogo.
LEVEL_ALLOWED_ZONES=salamanca,chamberi,retiro,pozuelo

# Proxy residencial Smartproxy para scraping de Idealista/Fotocasa.
# Formato: http://usuario:contraseña@host:puerto
# Si está configurado, se usa como fallback cuando recibe 403/429.
# Obtén las credenciales exactas de tu dashboard Smartproxy:
# Dashboard → Residential Proxy → Configuración de proxy
# IMPORTANTE: este fichero es el TEMPLATE público — nunca pegues
# credenciales reales aquí. Ponlas únicamente en `.env.local` (que está
# gitignored).
SMARTPROXY_URL=http://user:password@eu.smartproxy.net:3120

# ============================================================
# SMTP Configuration for Password Reset & Notifications
# ============================================================
# Fallback: si email_config table en BD está vacía, se usan estas variables.
# Para producción, configura estos valores en `.env.local` o usa el panel admin.
# Ejemplo con Gmail: SMTP_SERVER=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_SSL=false
# Ejemplo con Mailtrap (testing): SMTP_SERVER=live.smtp.mailtrap.io, SMTP_PORT=2525, SMTP_USE_SSL=false
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_USE_SSL=false
FROM_EMAIL=noreply@bcousinoprop.com
FROM_NAME=SmartBC
EMAIL_ENCRYPTION_KEY=your-encryption-key-for-password-storage
