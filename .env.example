# ─────────────────────────────────────────────────────────────────────────────
# casafari-mio · variables de entorno (PLANTILLA)
# Copiar a .env y rellenar. NUNCA commitear el .env real (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Postgres self-hosted en el VPS, con PostGIS) ──────────────
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://casafari:CHANGE_ME@localhost:5432/casafari

# ── Proxies ──────────────────────────────────────────────────────────────────
# Proveedor activo: geonode | smartproxy
PROXY_PROVIDER=geonode

# Geonode (residential) — destino: más barato. Rellenar al migrar.
GEONODE_PROXY_HOST=
GEONODE_PROXY_PORT=
GEONODE_PROXY_USER=
GEONODE_PROXY_PASS=

# Smartproxy (legacy / fallback). NO pegar la contraseña real en el repo.
# (La que estaba en uso debería ROTARSE por haberse compartido en claro.)
SMARTPROXY_PROXY_HOST=proxy.smartproxy.net
SMARTPROXY_PROXY_PORT=3120
SMARTPROXY_PROXY_USER=
SMARTPROXY_PROXY_PASS=

# Geo-targeting de los proxies residenciales
PROXY_COUNTRY=ES

# Smartproxy — cuenta dedicada a Chile (Portalinmobiliario + geocodificación
# de roles SII vía web/lib/geocode-cl.ts y scraper/lib/fetch.mjs perfil
# 'portalinmobiliario'). Separada de SMARTPROXY_PROXY_* (España/Idealista)
# para no romper ese scraping si esta cuenta se rota. Rellenar en el .env
# real del servidor — NUNCA pegar el password real aquí.
SMARTPROXY_CL_HOST=us.smartproxy.net
SMARTPROXY_CL_PORT=3121
SMARTPROXY_CL_USER=
SMARTPROXY_CL_PASS=

# Evomi (residential, geo Chile) — proxy ACTIVO para el barrido 24/7 de Portal
# Inmobiliario (plan Anuncios CL, ver docs/PLAN-ANUNCIOS-CL.md · H10). Reemplaza
# a Smartproxy/Geonode como proxy de Chile; las SMARTPROXY_CL_* quedan como
# fallback legacy. Rellenar SOLO en el .env real del servidor — NUNCA el valor
# real aquí.
EVOMI_PROXY_HOST=
EVOMI_PROXY_PORT=
EVOMI_PROXY_USER=
EVOMI_PROXY_PASS=

# Estas cuatro se pueden cambiar desde la UI (Configuración → Proxy (Evomi CL)),
# que reescribe este archivo. Tanto la app como el worker lo tienen montado y lo
# releen en caliente (scraper/lib/env-vivo.mjs), así que el cambio surte efecto
# sin reiniciar contenedores. El deploy YA NO las pisa con los secrets del repo:
# esos solo siembran una máquina nueva (ver .github/workflows/deploy.yml).

# Barrido de Portal Inmobiliario: siempre por proxy, para no enseñar la IP de la
# VPS al portal. `PI_SOLO_PROXY=0` vuelve al modo directo-primero (diagnóstico).
PI_SOLO_PROXY=
# Rescate por vía DIRECTA cuando el que falla es el proxy (no resuelve, no
# conecta, credenciales rechazadas) — evita que una caída del proveedor deje el
# barrido parado durante días. NO se activa si el portal nos bloquea o devuelve
# la variante ligera: ahí sigue mandando la decisión de no exponer la IP.
# `PI_FALLBACK_DIRECTO=0` lo desactiva.
PI_FALLBACK_DIRECTO=

# ── Object Storage (Hetzner, S3-compatible, región Helsinki hel1) ────────────
# Bucket público de fotos/media (plan Anuncios CL · H7) y bucket privado de
# backups restic de Postgres (H20). Un solo contrato cubre ambos (~€6,49/mes).
# Los Access/Secret Key S3 se generan en la consola de Hetzner y van SOLO en el
# .env real del servidor — NUNCA el valor real aquí.
HETZNER_S3_ENDPOINT=https://hel1.your-objectstorage.com
HETZNER_S3_REGION=hel1
# Fotos/media (bucket público, read-only)
HETZNER_S3_BUCKET=anuncios-bcp
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
# Backups Postgres (bucket privado, restic habla S3 nativo)
HETZNER_S3_BACKUP_BUCKET=backups-bcp
HETZNER_S3_BACKUP_ACCESS_KEY=
HETZNER_S3_BACKUP_SECRET_KEY=

# ── IA (OpenRouter — solo fallback, presupuesto duro) ────────────────────────
OPENROUTER_API_KEY=
AI_MONTHLY_BUDGET_EUR=30
AI_MODEL_WORKHORSE=google/gemini-2.5-flash-lite
AI_MODEL_CHEAP=qwen/qwen3-8b
# Chatbot del CRM (widget flotante, web/components/ChatWidget.tsx) — separado
# del workhorse/cheap de arriba a propósito: este usa un modelo con sufijo
# ":free" en OpenRouter (costo $0, pero rate-limited y puede cambiar de
# disponibilidad sin aviso por parte de OpenRouter).
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Catastro (servicios públicos, sin clave; control de rate-limit) ──────────
CATASTRO_RATE_LIMIT_RPS=1

# ── Google Maps (web/app/mapa-3d/) — Maps JavaScript API con billing activo.
# Se expone al navegador (prefijo NEXT_PUBLIC_), así que restringir por
# referente HTTP en Google Cloud Console es obligatorio, no opcional.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── DealerNet (proveedor contratado — directorio de teléfonos/contactabilidad
# Chile, web/lib/dealernet.ts). Credenciales propias del contrato, NUNCA
# commitear el valor real. ────────────────────────────────────────────────────
DEALERNET_USER=
DEALERNET_PASSWORD=
DEALERNET_WSDL_URL=https://infows.dealernet.cl/wsinfodlnt.asmx

# ── SmartBC (CRM comercial de Benjamín Cousiño Propiedades, API pública v1)
# Destino de las captaciones ya trabajadas: scraper/sync-smartbc-cl.mjs las
# sube solas y las mantiene actualizadas (ver docs/SMARTBC-INTEGRACION.md).
# La clave es secreta y revocable: NUNCA commitear el valor real. Si se pierde,
# se genera otra desde /cl/admin/integraciones y se revoca la anterior.
SMARTBC_BASE_URL=https://portal.bcousinoprop.com
SMARTBC_API_KEY=

# Valor de UF (Unidades de Fomento) en pesos CLP para conversión de divisas
# Actualizar según valor actual en SII (aproximadamente 36.500 CLP/UF en 2024-2025)
UF_VALUE=36500

# ── Scraping / cron ──────────────────────────────────────────────────────────
CRON_SECRET=CHANGE_ME
SCRAPE_MAX_PAGES=60

# ── Dominio gratis (opcional — ver infra/dominio-gratis.md) ──────────────────
# nip.io no necesita nada: http://204-168-174-0.nip.io funciona solo.
# DuckDNS (nombre bonito + auto-update de IP):
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
